---
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { withBase } from '../consts';

interface Props {
	posts?: Awaited<ReturnType<typeof getCollection<'blog'>>>;
}

const { posts } = Astro.props;
---

<ul class="post-list">
	{
		posts?.map((post) => (
			<li>
				<a class="post-row" href={withBase(`blog/${post.id}/`)}>
					<div class="post-meta">
						<span class="date">
							<FormattedDate date={post.data.pubDate} />
						</span>
					</div>
					<div class="post-body">
						<h2 class="title">{post.data.title}</h2>
						{post.data.description && <p class="desc">{post.data.description}</p>}
					</div>
					{post.data.heroImage && (
						<img class="thumb" src={post.data.heroImage} alt="" width="120" height="80" />
					)}
				</a>
			</li>
		))
	}
</ul>

<style>
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.post-list li {
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.post-row {
		display: grid;
		grid-template-columns: 7.5rem 1fr auto;
		gap: 1rem 1.25rem;
		align-items: start;
		padding: 1.25rem 0.15rem;
		text-decoration: none;
		color: inherit;
		transition: background 0.15s ease;
	}
	.post-row:hover {
		background: rgba(var(--gray-light), 0.45);
	}
	.post-meta {
		padding-top: 0.35rem;
	}
	.date {
		display: block;
		font-size: 0.85rem;
		color: rgb(var(--gray));
		white-space: nowrap;
	}
	.title {
		margin: 0;
		font-size: 1.25rem;
		line-height: 1.35;
		color: rgb(var(--black));
		font-weight: 700;
	}
	.post-row:hover .title {
		color: var(--accent);
	}
	.desc {
		margin: 0.4rem 0 0;
		font-size: 0.95rem;
		line-height: 1.5;
		color: rgb(var(--gray));
	}
	.thumb {
		width: 120px;
		height: 80px;
		object-fit: cover;
		border-radius: 6px;
		background: rgb(var(--gray-light));
	}
	@media (max-width: 640px) {
		.post-row {
			grid-template-columns: 1fr auto;
		}
		.post-meta {
			grid-column: 1 / -1;
			padding-top: 0;
		}
		.thumb {
			width: 88px;
			height: 64px;
		}
	}
</style>
