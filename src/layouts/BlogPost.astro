---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
}

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 1.5rem auto 0;
			}
			.hero-image img {
				display: block;
				width: 100%;
				max-height: 360px;
				object-fit: cover;
				margin: 0 auto;
				border-radius: 8px;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: left;
				line-height: 1.2;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article>
				{
					heroImage && (
						<div class="hero-image">
							<img width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}
				<div class="prose">
					<div class="title">
						<div class="date">
							<time datetime={pubDate.toISOString()}>
								{
									pubDate.toLocaleDateString('zh-CN', {
										year: 'numeric',
										month: 'short',
										day: 'numeric',
									})
								}
							</time>
							{
								updatedDate && (
									<div class="last-updated-on">
										更新于{' '}
										<time datetime={updatedDate.toISOString()}>
											{updatedDate.toLocaleDateString('zh-CN', {
												year: 'numeric',
												month: 'short',
												day: 'numeric',
											})}
										</time>
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
